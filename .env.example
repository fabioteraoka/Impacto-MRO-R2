# ==============================================================================
# IMPACTO AVIATION MRO - CONFIGURAÇÃO DE AMBIENTE (COM 200607-05 / EASA.145.1003)
# ==============================================================================

# BANCO DE DADOS POSTGRESQL (LOCAL OU NUVEM)
# Formato padrão de conexão:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/impacto_mro"

# Parâmetros individuais (usados caso DATABASE_URL não esteja definida):
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="postgres"
PGDATABASE="impacto_mro"
PGSSL="false"

# ARMAZENAMENTO DE DOCUMENTOS E DOSSIÊS (ABSTRAÇÃO PARA NUVEM / STORAGE PROVIDER)
# Opções: "local" | "s3"
STORAGE_DRIVER="local"
STORAGE_BASE_PATH="./storage"

# Configurações para futuro S3 / Cloud Storage (quando migrar para nuvem):
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET_NAME="impacto-mro-dossies"

# SERVIDOR WEB E APLICAÇÃO
PORT=3000
NODE_ENV="development"

# GEMINI_API_KEY: Injetada automaticamente pelo Google AI Studio caso utilizada.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base do ambiente (injetada no runtime ou configurada localmente)
APP_URL="http://localhost:3000"
